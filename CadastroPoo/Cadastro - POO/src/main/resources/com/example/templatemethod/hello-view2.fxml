<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="640.0" prefWidth="760.0" styleClass="root" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.templatemethod.Controller.ControllerInformacoes">

    <children>
        <VBox maxWidth="500.0" spacing="16.0" styleClass="card">
            <padding>
                <Insets bottom="36.0" left="45.0" right="45.0" top="36.0" />
            </padding>

            <children>
                <VBox spacing="6.0">
                    <Label styleClass="title" text="Gerenciar usuários" />
                    <Label styleClass="subtitle" text="Consulte e administre os cadastros do sistema." />
                </VBox>

                <VBox spacing="12.0">
                    <Button fx:id="btnVer" maxWidth="1.7976931348623157E308" onAction="#ver" prefHeight="54.0" styleClass="menu-button" text="Ver usuários" />

                    <Button fx:id="btnModificar" maxWidth="1.7976931348623157E308" onAction="#modificar" prefHeight="54.0" styleClass="menu-button" text="Modificar usuário" />

                    <Button fx:id="btnRemover" maxWidth="1.7976931348623157E308" onAction="#remover" prefHeight="54.0" styleClass="danger-button" text="Remover usuário" />

                    <Button fx:id="btnSair" maxWidth="1.7976931348623157E308" onAction="#sair" prefHeight="46.0" styleClass="secondary-button" text="Fechar" />
                </VBox>

                <Label alignment="CENTER" styleClass="footer" text="Gerenciamento de dados" />
            <StackPane prefHeight="150.0" prefWidth="200.0">
               <children>
                  <ImageView fitHeight="203.0" fitWidth="228.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../Imagens/soniclogo.png" />
                     </image>
                  </ImageView>
               </children>
            </StackPane>
            </children>
        </VBox>
    </children>
</StackPane>
